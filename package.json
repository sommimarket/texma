{
  "name": "texma",
  "version": "1.4.3",
  "private": true,
  "description": "TEXMA · Planner personal — PWA + APK (Capacitor)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "abrir:android": "npm run sync && cap open android",
    "apk:debug": "npm run sync && cd android && .\\gradlew.bat assembleDebug",
    "apk": "npm run sync && cd android && .\\gradlew.bat assembleRelease",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^7.0.1",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@supabase/supabase-js": "^2.112.0"
  }
}
